" ============================================
" persistence.nvim - セッション自動保存・復元
" ============================================
" 引数なしで nvim を起動すると、そのディレクトリで前回開いていたタブ・ファイルを自動で復元する
" （ファイルやディレクトリを指定して起動した場合は復元しない）
" 使い方:
"   <leader>qs      : 現在の cwd のセッションを復元
"   <leader>ql      : 最後のセッションを復元
"   <leader>qd      : セッション保存を無効化（一時的な使い捨て起動）
" ターミナルはセッションに保存しない
set sessionoptions-=terminal
lua <<EOF
local persistence_ok, persistence = pcall(require, "persistence")
if persistence_ok then
  persistence.setup()

  local session_group = vim.api.nvim_create_augroup("PersistenceAutoRestore", { clear = true })
  -- パイプ入力（例: git diff | nvim -）で起動した場合は復元しない
  vim.api.nvim_create_autocmd("StdinReadPre", {
    group = session_group,
    callback = function() vim.g.started_with_stdin = true end,
  })
  vim.api.nvim_create_autocmd("VimEnter", {
    group = session_group,
    nested = true,  -- 復元したバッファで FileType 等の autocmd を発火させる
    callback = function()
      -- ターミナル内で起動した入れ子の nvim では、復元も保存もしない（親のセッションを上書きしないため）
      if vim.env.NVIM then
        persistence.stop()
        return
      end
      -- headless 起動（Ansible からのパーサーインストール等）では復元しない
      if vim.fn.argc(-1) == 0 and not vim.g.started_with_stdin and #vim.api.nvim_list_uis() > 0 then
        persistence.load()
      end
    end,
  })
  -- 保存前にサイドバー・ターミナルのウィンドウを閉じる（復元時に空のウィンドウが残るのを防ぐ）
  vim.api.nvim_create_autocmd("User", {
    group = session_group,
    pattern = "PersistenceSavePre",
    callback = function()
      for _, win in ipairs(vim.api.nvim_list_wins()) do
        local buf = vim.api.nvim_win_get_buf(win)
        if vim.tbl_contains({ "neo-tree", "aerial" }, vim.bo[buf].filetype) or vim.bo[buf].buftype == "terminal" then
          -- タブ内の最後のウィンドウは閉じられないため pcall で無視する
          pcall(vim.api.nvim_win_close, win, true)
        end
      end
    end,
  })

  vim.keymap.set('n', '<leader>qs', function() persistence.load() end,              { silent = true, desc = "Restore session" })
  vim.keymap.set('n', '<leader>ql', function() persistence.load({ last = true }) end, { silent = true, desc = "Restore last session" })
  vim.keymap.set('n', '<leader>qd', function() persistence.stop() end,              { silent = true, desc = "Don't save session" })
end
EOF

