" ============================================
" nvim-treesitter - 構文解析・ハイライト
" ============================================
" パーサーは Ansible（neovim_treesitter_parsers）でインストールする
" 使い方（Neovim 0.12 標準のビジュアルモード操作）:
"   v → an          : 選択範囲をノード単位で拡張（続けて an で更に外側へ）
"   in              : 選択範囲を縮小
lua <<EOF
local treesitter_ok = pcall(require, "nvim-treesitter")
if treesitter_ok then
  vim.api.nvim_create_autocmd("FileType", {
    group = vim.api.nvim_create_augroup("TreesitterStart", { clear = true }),
    callback = function(args)
      -- パーサーのない filetype では何もしない
      if not pcall(vim.treesitter.start, args.buf) then return end
      -- インデント定義のある言語のみ treesitter のインデントを使う
      local lang = vim.treesitter.language.get_lang(vim.bo[args.buf].filetype)
      if lang and vim.treesitter.query.get(lang, "indents") then
        vim.bo[args.buf].indentexpr = "v:lua.require'nvim-treesitter'.indentexpr()"
      end
    end,
  })
end
EOF

