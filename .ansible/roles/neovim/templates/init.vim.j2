lua <<EOF
-- lualine 設定
local lualine_ok, lualine = pcall(require, "lualine")
if lualine_ok then
  -- カスタム関数: カレントディレクトリを短縮表示
  local function shortened_cwd()
    local cwd = vim.fn.getcwd()
    local home = vim.fn.expand("~")
    cwd = cwd:gsub("^" .. home, "~")
    return cwd
  end

  lualine.setup({
    options = {
      theme = 'tokyonight',
      component_separators = { left = '', right = ''},
      section_separators = { left = '', right = ''},
      disabled_filetypes = {
        statusline = {},
        winbar = {},
      },
      globalstatus = true,  -- グローバルステータスライン
    },
    sections = {
      lualine_a = {'mode'},
      lualine_b = {'branch', 'diff', 'diagnostics'},
      lualine_c = {shortened_cwd},
      lualine_x = {'encoding', 'fileformat', 'filetype'},
      lualine_y = {'progress'},
      lualine_z = {'location'}
    },
    inactive_sections = {
      lualine_a = {},
      lualine_b = {},
      lualine_c = {'filename'},
      lualine_x = {'location'},
      lualine_y = {},
      lualine_z = {}
    },
    extensions = {}
  })
end

-- bufferline 設定 (タブライン)
local bufferline_ok, bufferline = pcall(require, "bufferline")
if bufferline_ok then
  -- カスタム関数: タブ名をカスタマイズ
  local function custom_tab_name(tab)
    local wins = vim.api.nvim_tabpage_list_wins(tab.tabnr)
    if #wins > 0 then
      local bufnr = vim.api.nvim_win_get_buf(wins[1])
      local bufname = vim.api.nvim_buf_get_name(bufnr)
      local buftype = vim.api.nvim_get_option_value('buftype', {buf = bufnr})

      -- ターミナルバッファの場合
      if buftype == 'terminal' then
        return 'Terminal'
      end

      -- 空のバッファ
      if bufname == '' then
        return '[No Name]'
      end

      -- ファイル名のみ
      return vim.fn.fnamemodify(bufname, ':t')
    end
    return tab.name
  end

  bufferline.setup({
    options = {
      mode = "tabs",  -- タブモード（バッファではなくタブを表示）
      themable = true,
      numbers = "none",
      close_command = "bdelete! %d",
      indicator = {
        style = 'underline',
      },
      modified_icon = '●',
      close_icon = '×',
      left_trunc_marker = '',
      right_trunc_marker = '',
      max_name_length = 30,
      max_prefix_length = 15,
      tab_size = 18,
      diagnostics = false,
      show_buffer_icons = true,
      show_buffer_close_icons = false,
      show_close_icon = false,
      show_tab_indicators = true,
      separator_style = "thin",
      always_show_bufferline = true,
      name_formatter = custom_tab_name,
    },
    highlights = {
      fill = {
        bg = '#1a1b26',  -- tokyonight bg
      },
      background = {
        fg = '#a9b1d6',  -- tokyonight fg_dark
        bg = '#16161e',  -- tokyonight bg_dark
      },
      tab = {
        fg = '#a9b1d6',
        bg = '#16161e',
      },
      tab_selected = {
        fg = '#c0caf5',  -- tokyonight fg
        bg = '#292e42',  -- tokyonight bg_highlight
        bold = true,
      },
      tab_separator = {
        fg = '#1a1b26',
        bg = '#16161e',
      },
      tab_separator_selected = {
        fg = '#1a1b26',
        bg = '#292e42',
      },
      buffer_selected = {
        fg = '#c0caf5',
        bg = '#292e42',
