" ============================================
" fzf-lua - ファジーファインダー
" ============================================
" 使い方（ノーマルモード）:
"   <Ctrl-p>        : プロジェクト内のファイルを検索（ファイル名）
"   <leader>/       : プロジェクト内をgrep検索（live grep / ファイル内容）
"                     ※ インサートモードの <Ctrl-f> は nvim-cmp 補完ドキュメントのスクロール
"   <Ctrl-g>        : カーソル下の単語でgrep検索
"   gs              : Git statusのファイルを検索
"   gl              : Gitログを表示
"   ビジュアルモードで <leader>/ : 選択したテキストをgrep検索
"   <leader>r       : 直前の検索を再開（クエリ・カーソル位置を復元）
"   <leader>s       : 現在のファイルのシンボル（関数・クラス等）を検索
"   <leader>S       : プロジェクト全体のシンボルを検索
"   検索結果内で:
"     <Enter>       : 新しいタブで開く（すでに開いていればそのタブへ移動）
"     <Ctrl-t>      : 新しいタブで開く
"     <Ctrl-v>      : 縦分割で開く
"     <Ctrl-s>      : 横分割で開く
"     <Ctrl-a>      : すべて選択/解除をトグル（複数選択して <Enter> で quickfix に送る）
lua <<EOF
local fzf_lua_ok, fzf_lua = pcall(require, "fzf-lua")
if fzf_lua_ok then
  -- 検索結果を :tab drop で開く（開いていればそのタブへ移動、なければ新しいタブ）
  -- 起動直後の空のタブでは新しいタブを作らずにそのまま開く
  -- 複数選択時は既定の動作どおり quickfix に送る
  local function tab_drop(selected, opts)
    if #selected > 1 then
      return require("fzf-lua.actions").file_sel_to_qf(selected, opts)
    end
    local is_empty = vim.api.nvim_buf_get_name(0) == "" and vim.bo.buftype == ""
      and not vim.bo.modified and vim.fn.line("$") == 1 and vim.fn.getline(1) == ""
    require("fzf-lua.actions").vimcmd_entry(is_empty and "drop" or "tab drop", selected, opts)
  end

  fzf_lua.setup({
    winopts = {
      height = 0.85,
      width = 0.80,
      preview = {
        layout = "vertical",
        vertical = "up:45%",
      },
    },
    keymap = {
      fzf = {
        ["ctrl-a"] = "toggle-all",
      },
    },
    actions = {
      -- true: デフォルトのアクションを引き継いだうえで enter だけ上書きする
      files = { true, ["enter"] = tab_drop },
    },
    -- LSP の結果が 1 件のときも tab drop で開く
    lsp = {
      jump1_action = tab_drop,
    },
    files = {
      fd_opts = "--hidden",
    },
    grep = {
      rg_opts = "--column --line-number --no-heading --color=always --smart-case --hidden",
      no_sort = true,
    },
  })

  vim.keymap.set('n', '<C-p>', fzf_lua.files, { silent = true, desc = "Find files" })
  vim.keymap.set('n', '<leader>/', fzf_lua.live_grep, { silent = true, desc = "Live grep" })
  vim.keymap.set('n', '<C-g>', fzf_lua.grep_cword, { silent = true, desc = "Grep word under cursor" })
  vim.keymap.set('x', '<leader>/', fzf_lua.grep_visual, { silent = true, desc = "Grep visual selection" })
  vim.keymap.set('n', 'gs', fzf_lua.git_status, { silent = true, desc = "Git status" })
  vim.keymap.set('n', 'gl', fzf_lua.git_commits, { silent = true, desc = "Git log" })
  vim.keymap.set('n', '<leader>r', fzf_lua.resume, { silent = true, desc = "Resume last search" })
  vim.keymap.set('n', '<leader>s', fzf_lua.lsp_document_symbols, { silent = true, desc = "Document symbols" })
  vim.keymap.set('n', '<leader>S', fzf_lua.lsp_live_workspace_symbols, { silent = true, desc = "Workspace symbols" })
end
EOF

